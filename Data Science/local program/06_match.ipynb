    "def http(code):\n",
    "    match code:\n",
    "        case 200:\n",
    "            return \"OK\"\n",
    "        case 404:\n",
    "            return \"Not found\"\n",
    "        case 999:\n",
    "            return \"Offline\"\n",
    "        case _:\n",
    "            return \"check your network\""
   ]
